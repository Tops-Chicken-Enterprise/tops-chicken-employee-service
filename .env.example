# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/tops_employee_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# WSO2 Identity Server 7.3.0 M2M Configurations
WSO2_BASE_URL=https://localhost:9443
WSO2_TOKEN_URL=https://localhost:9443/oauth2/token
WSO2_SCIM_USERS_URL=https://localhost:9443/scim2/Users
WSO2_CLIENT_ID=your_wso2_client_id_here
WSO2_CLIENT_SECRET=your_wso2_client_secret_here
WSO2_SSL_TRUST_ALL=true
WSO2_API_RESOURCE_IDENTIFIER=https://api.topschicken.com/erp
WSO2_ASK_PASSWORD_ENABLED=true

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379